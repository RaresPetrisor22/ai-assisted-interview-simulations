{
  "name": "movie-database-api",
  "version": "1.0.0",
  "description": "Movie database REST API (Express + Mongoose)",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node scripts/run-tests.mjs",
    "test:visible": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --runInBand test/visible.test.js",
    "reveal": "node scripts/reveal.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "mongodb-memory-server": "^11.0.0",
    "mongoose": "^8.24.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "<rootDir>/test/setupEnv.cjs"
    ],
    "testTimeout": 15000
  }
}
