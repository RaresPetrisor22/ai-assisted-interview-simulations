{
  "name": "car-marketplace-backend",
  "version": "1.0.0",
  "description": "Car marketplace REST API (Express + Mongoose)",
  "type": "module",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node scripts/run-tests.mjs",
    "test:visible": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/visible.test.js",
    "reveal": "node scripts/reveal.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 30000,
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
